---
import '@fontsource-variable/geist';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Highlights the matching nav item. */
  section?: 'home' | 'work';
  /** Case-study pages use a full-height two-column layout and hide the footer. */
  showFooter?: boolean;
  /** 'paper' is the white case-study surface; 'canvas' is the default off-white. */
  surface?: 'canvas' | 'paper';
}

const {
  title,
  description = 'Product design portfolio: developer infrastructure, systems and status language.',
  section = 'home',
  showFooter = true,
  surface = 'canvas',
} = Astro.props;

const paper = surface === 'paper';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={['min-h-screen', paper ? 'bg-white' : 'bg-canvas']}>
    <header
      class:list={[
        'sticky top-0 z-40 border-b backdrop-blur-md',
        paper ? 'border-cs-rule bg-white/85' : 'border-hairline bg-canvas/85',
      ]}
    >
      <div class="mx-auto flex h-16 w-full max-w-[1800px] items-center gap-6 px-6 lg:px-12">
        <a href="/" class="flex flex-none items-center gap-2.5">
          <span
            class="grid size-7 place-items-center rounded-full bg-ink text-[11px] font-semibold text-white"
            >JG</span
          >
          <span class="t-label-sm">Jose Gallardo</span>
        </a>

        <nav class="mx-auto hidden items-center gap-1 sm:flex">
          <a
            href="/"
            class:list={[
              'rounded-full px-3 py-2 t-body-md transition-colors hover:text-ink',
              section === 'home' ? 'text-ink' : 'text-body',
            ]}>Home</a
          >
          <a
            href="/#work"
            class:list={[
              'rounded-full px-3 py-2 t-body-md transition-colors hover:text-ink',
              section === 'work' ? 'text-ink' : 'text-body',
            ]}>Work</a
          >
        </nav>

        <!-- LinkedIn reads as a plain text link, not a button. -->
        <div class="ml-auto flex flex-none items-center gap-5 sm:ml-0">
          <a
            class="t-body-md text-body transition-colors hover:text-ink"
            href="https://www.linkedin.com/in/josegdesign/"
            target="_blank"
            rel="noopener">LinkedIn</a
          >
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    {
      showFooter && (
        <footer class="border-t border-hairline bg-canvas">
          <div class="mx-auto flex max-w-shell flex-wrap items-center justify-between gap-4 px-6 py-16">
            <p class="t-body-md text-body">Jose Gallardo, Product Designer</p>
            <p class="t-body-md text-mute">
              <a class="hover:text-ink" href="mailto:hello@example.com">
                hello@example.com
              </a>
              <span class="px-2 text-hairline">/</span>
              <a class="hover:text-ink" href="https://www.linkedin.com/in/josegdesign/" target="_blank" rel="noopener">
                LinkedIn
              </a>
            </p>
          </div>
        </footer>
      )
    }
  </body>
</html>
