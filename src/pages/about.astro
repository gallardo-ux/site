---
import Base from '../layouts/Base.astro';
---

<Base title="About Me | Jose Gallardo" description="About Jose Gallardo, a product and visual designer based in Watsonville, CA." section="about">
  <div class="mx-auto w-full max-w-[1200px] px-6 py-16 lg:px-12 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
      <div>
        <p class="t-eyebrow">About Me</p>
        <h1 class="t-display-xl mt-4">Hello there, my name is Jose Gallardo.</h1>

        <p class="t-body-lg mt-8 text-body">
          I am a Product Designer with 3+ years of experience based in Watsonville, CA. I fell in love with design
          through the challenge of turning ideas into meaningful experiences and solving problems in
          ways that make people’s lives easier.
        </p>

        <p class="t-body-lg mt-6 text-body">
          I currently hold a Bachelor of Science in Communication Design with a concentration in
          Visual Design from California State University of Monterey Bay.
        </p>

        <p class="t-body-lg mt-6 text-body">
          When I’m not designing, I like going on hikes, exploring nature, and love going to the gym.
        </p>
      </div>

      <div class="overflow-hidden rounded-[24px] border border-hairline bg-white shadow-whisper">
        <img
          src="/profile-image-jose.jpg"
          alt="Jose Gallardo headshot"
          class="h-[560px] w-full object-cover object-center"
        />
      </div>
    </div>
  </div>
</Base>
